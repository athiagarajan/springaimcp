# ==============================================================================
# TempleInfo & Spring AI MCP Environment Variables Template
# Copy this file to .env (or backend/.env) and populate the required secrets.
# IMPORTANT: NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# Active Spring Profile: 'local' (default) or 'render'
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------------------------
# Secrets (Required)
# ------------------------------------------------------------------------------
# PostgreSQL Database Password (set to your local password or AWS RDS password)
SPRING_DATASOURCE_PASSWORD=

# Google Gemini API Key for AI translations
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Local Profile Overrides (Optional - defaults already set in application-local.yml)
# ------------------------------------------------------------------------------
# LOCAL_DB_HOST=dthiagar-ubuntu
# LOCAL_DB_PORT=5432
# LOCAL_DB_NAME=templeinfo
# SPRING_DATASOURCE_USERNAME=templeinfo_user

# ------------------------------------------------------------------------------
# Render Cloud Profile Overrides (Configured in Render Dashboard Environment Settings)
# ------------------------------------------------------------------------------
# PORT=10000
# DB_HOST=templeinfo-db.cnwoi0c6ort7.us-east-2.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=templeinfo
# SPRING_DATASOURCE_USERNAME=postgres
